# 阿里云 OSS（私有 Bucket，经 /chat/oss/* 代理读写，勿前端直连）
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=czp-ai-agent
OSS_PREFIX=xhs/images
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 题库导入：上传上限（字节，默认 20MB）；仅支持 .docx
# QUESTION_IMPORT_MAX_BYTES=20971520
# 提取文字在接口中返回的最大预览字数（完整文本仍存 extracted.txt）
# QUESTION_IMPORT_TEXT_PREVIEW_CHARS=80000
# AI 结构化（短卷 ≤2.5 万字一次性；更长自动分批，如两千题卷）
# QUESTION_PARSE_AUTO_CHUNK_CHARS=25000
# QUESTION_PARSE_CHUNK_CHARS=8000
# QUESTION_PARSE_MAX_SPLIT_PARTS=120
# QUESTION_PARSE_MAX_TOKENS=8192
# QUESTION_PARSE_TIMEOUT_SECONDS=180
# 强制始终分批：QUESTION_PARSE_ENABLE_CHUNKING=1
# 每日一题答题卡背景图（默认 mcp_server/assets/quiz/card_bg.png）
# QUIZ_CARD_BG_PATH=/path/to/your/bg.png
